# NexusOps AI (Admin Application) — environment template
# Copy to ".env" and fill in real values. NEVER commit the real .env.

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Database Configuration (shared with Claude_ai_athena)
# Local PostgreSQL (Docker - for dev)
# DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/llmatscale_local"

# AWS RDS (production)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/claude_ai_athena"

# Encryption key for sensitive data (same as Athena - shared DB)
KEY_ENCRYPTION_SECRET="your_64_hex_character_key"

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=admin@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=admin@example.com

# App URL (for invitation links)
APP_URL=http://localhost:3001

# Athena app URL (for password reset links sent to users)
ATHENA_URL=https://your-faborch-host

# Athena URL for client-side redirects (build-time)
NEXT_PUBLIC_ATHENA_URL=https://your-faborch-host

# Admin Configuration (seed bootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Admin
