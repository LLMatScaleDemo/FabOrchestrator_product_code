# Copy to terraform.tfvars and adjust. Non-secret values only — secrets are set
# out of band (see README "Secrets").

region = "us-west-2"

# --- Phase 1: adopt today's deployment as-is (no behaviour change) ---
fab_use_cmf_vpc  = false
create_admin_env = false

