generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id                          String          @id @default(uuid())
  name                        String          @unique
  description                 String?
  isSystemRole                Boolean         @default(false) @map("is_system_role")
  permissions                 Json            @default("[]")
  allowedModels               Json            @default("[]") @map("allowed_models")
  systemInstructions          String?         @map("system_instructions")
  customInstructionsEnabled   Boolean         @default(true) @map("custom_instructions_enabled")
  customInstructionsMaxLength Int             @default(1000) @map("custom_instructions_max_length")
  personalMcpEnabled          Boolean         @default(false) @map("personal_mcp_enabled")
  personalMcpMaxCount         Int             @default(3) @map("personal_mcp_max_count")
  dailyRequestLimit           Int?            @map("daily_request_limit")
  dailyTokenLimit             Int?            @map("daily_token_limit")
  promptSuggestions           Json            @default("[]") @map("prompt_suggestions")
  createdAt                   DateTime        @default(now()) @map("created_at")
  updatedAt                   DateTime        @updatedAt @map("updated_at")
  invitations                 Invitation[]
  mcpConnections              McpConnection[]
  users                       User[]

  @@map("roles")
}

model User {
  id                                                   String              @id @default(uuid())
  email                                                String              @unique
  passwordHash                                         String              @map("password_hash")
  name                                                 String?
  avatarUrl                                            String?             @map("avatar_url")
  anthropicApiKeyEncrypted                             String?             @map("anthropic_api_key_encrypted")
  preferences                                          Json                @default("{\"theme\": \"system\", \"fontSize\": 16, \"codeTheme\": \"github-dark\", \"messageDensity\": \"comfortable\"}")
  createdAt                                            DateTime            @default(now()) @map("created_at")
  lastLogin                                            DateTime?           @map("last_login")
  emailVerified                                        Boolean             @default(false) @map("email_verified")
  forcePasswordChange                                  Boolean             @default(false) @map("force_password_change")
  isAdmin                                              Boolean             @default(false) @map("is_admin")
  passwordChangedAt                                    DateTime?           @map("password_changed_at")
  roleId                                               String?             @map("role_id")
  status                                               String              @default("ACTIVE")
  artifacts                                            Artifact[]
  auditLogs                                            AuditLog[]
  cmfPackages                                          Package[]
  cmfRuns                                              Run[]
  cmfStagedUploads                                     StagedUpload[]
  conversations                                        Conversation[]
  error_audit_logs_error_audit_logs_resolved_byTousers error_audit_logs[]  @relation("error_audit_logs_resolved_byTousers")
  error_audit_logs_error_audit_logs_user_idTousers     error_audit_logs[]  @relation("error_audit_logs_user_idTousers")
  invitationsSent                                      Invitation[]        @relation("InvitedByUser")
  mcpConnections                                       McpConnection[]
  memoryFiles                                          MemoryFile[]
  pinnedDashboards                                     PinnedDashboard[]
  prompt_audit_logs                                    prompt_audit_logs[]
  sessions                                             Session[]
  usageRecords                                         UsageRecord[]
  sessionLogs                                          UserSessionLog[]
  role                                                 Role?               @relation(fields: [roleId], references: [id])

  @@index([email])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  ipAddress  String?   @map("ip_address")
  lastUsedAt DateTime? @map("last_used_at")
  userAgent  String?   @map("user_agent")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Conversation {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  title         String     @default("New Conversation")
  model         String
  activeMcpIds  Json       @default("[]") @map("active_mcp_ids")
  isPinned      Boolean    @default(false) @map("is_pinned")
  isShared      Boolean    @default(false) @map("is_shared")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  lastMessageAt DateTime?  @map("last_message_at")
  deletedAt     DateTime?  @map("deleted_at")
  agent         String     @default("chat")
  artifacts     Artifact[]
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  role           String
  content        String
  parts          Json?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  editedAt       DateTime?    @map("edited_at")
  artifacts      Artifact[]
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Artifact {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  messageId      String       @map("message_id")
  userId         String       @map("user_id")
  type           String       @default("html")
  title          String
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@map("artifacts")
}

model McpConnection {
  id                       String    @id @default(uuid())
  userId                   String?   @map("user_id")
  name                     String
  serverUrl                String    @map("server_url")
  authType                 String    @default("none") @map("auth_type")
  authCredentialsEncrypted String?   @map("auth_credentials_encrypted")
  availableTools           Json      @default("[]") @map("available_tools")
  isActive                 Boolean   @default(true) @map("is_active")
  status                   String    @default("disconnected")
  lastError                String?   @map("last_error")
  sessionId                String?   @map("session_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  lastConnectedAt          DateTime? @map("last_connected_at")
  roleId                   String?   @map("role_id")
  registryId               String?   @map("registry_id")
  role                     Role?     @relation(fields: [roleId], references: [id])
  user                     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([registryId])
  @@map("mcp_connections")
}

model MemoryFile {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  path      String
  content   String
  scope     String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, path])
  @@unique([scope, path])
  @@index([userId])
  @@index([scope])
  @@map("memory_files")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

model Invitation {
  id          String    @id @default(uuid())
  email       String
  roleId      String    @map("role_id")
  invitedById String    @map("invited_by_id")
  token       String    @unique
  status      String    @default("PENDING")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  invitedBy   User      @relation("InvitedByUser", fields: [invitedById], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@index([token])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserSessionLog {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  sessionTokenHash   String?       @unique @map("session_token_hash")
  loginTime          DateTime      @default(now()) @map("login_time") @db.Timestamptz(6)
  logoutTime         DateTime?     @map("logout_time") @db.Timestamptz(6)
  lastActivityAt     DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  idleSeconds        Int           @default(0) @map("idle_seconds")
  sessionStatus      SessionStatus @default(ACTIVE) @map("session_status")
  closedReason       String?       @map("closed_reason")
  loginIp            String?       @map("login_ip")
  loginUserAgent     String?       @map("login_user_agent")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  idle_episodes      Json          @default("[]")
  idle_episode_count Int           @default(0)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginTime(sort: Desc)])
  @@index([sessionStatus])
  @@index([loginTime])
  @@map("user_session_logs")
}

model UsageRecord {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  model               String
  inputTokens         Int      @map("input_tokens")
  outputTokens        Int      @map("output_tokens")
  thinkingTokens      Int      @default(0) @map("thinking_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  conversationId      String?  @map("conversation_id")
  requestDurationMs   Int?     @map("request_duration_ms")
  createdAt           DateTime @default(now()) @map("created_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([model])
  @@map("usage_records")
}

model PlatformSettings {
  id                 String   @id
  colorTheme         String   @default("fab-blue") @map("color_theme")
  updatedById        String?  @map("updated_by_id")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  auditRetentionDays Int      @default(90) @map("audit_retention_days")

  @@map("platform_settings")
}

model ModelRegistry {
  id                  String   @id @default(uuid())
  modelId             String   @unique @map("model_id")
  displayName         String   @map("display_name")
  description         String?
  inputCostPer1M      Float    @default(0) @map("input_cost_per_1m")
  outputCostPer1M     Float    @default(0) @map("output_cost_per_1m")
  cacheReadCostPer1M  Float    @default(0) @map("cache_read_cost_per_1m")
  cacheWriteCostPer1M Float    @default(0) @map("cache_write_cost_per_1m")
  thinkingType        String   @default("adaptive") @map("thinking_type")
  thinkingBudget      Int?     @map("thinking_budget")
  isActive            Boolean  @default(true) @map("is_active")
  isDefault           Boolean  @default(false) @map("is_default")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([sortOrder])
  @@map("model_registry")
}

model Package {
  id                String             @id @default(cuid())
  cmfId             String             @unique @map("cmf_id")
  name              String
  filename          String
  checksum          String
  sizeBytes         BigInt             @map("size_bytes")
  contentType       String             @map("content_type")
  createdByUserId   String             @map("created_by_user_id")
  lastResult        Int?               @map("last_result")
  lastOperation     Operation?         @map("last_operation")
  lastRunAt         DateTime?          @map("last_run_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  file              PackageFile?
  createdBy         User               @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  runs              Run[]
  validationReports ValidationReport[]

  @@index([createdAt])
  @@map("cmf_packages")
}

model StagedUpload {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  filename        String
  s3Key           String   @map("s3_key")
  status          String   @default("UPLOADED")
  packageName     String?  @map("package_name")
  packageCmfId    String?  @map("package_cmf_id")
  selectedTypes   Json?    @map("selected_types")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  packageCmfDbKey String?  @map("package_cmf_db_key")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([status])
  @@map("cmf_staged_uploads")
}

model PackageFile {
  id        String   @id @default(cuid())
  packageId String   @unique @map("package_id")
  filename  String
  s3Key     String   @map("s3_key")
  createdAt DateTime @default(now()) @map("created_at")
  package   Package  @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("cmf_package_files")
}

model ValidationReport {
  id           String   @id @default(cuid())
  packageId    String   @map("package_id")
  ok           Boolean
  errorCount   Int      @map("error_count")
  warningCount Int      @map("warning_count")
  report       Json
  advisory     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  package      Package  @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([packageId])
  @@map("cmf_validation_reports")
}

model Run {
  id                 String    @id @default(cuid())
  packageId          String    @map("package_id")
  userId             String    @map("user_id")
  operation          Operation
  status             RunStatus @default(QUEUED)
  cmfBaselineEndDate String?   @map("cmf_baseline_end_date")
  selectedTypes      Json      @map("selected_types")
  result             Int?
  log                Json?
  error              String?
  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")
  package            Package   @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([packageId])
  @@index([startedAt])
  @@map("cmf_runs")
}

/// A dashboard an admin has pinned so every role can see it.
///
/// Stores the RECIPE, not the rendered HTML: the dashboard id plus whichever
/// lot/product the admin asked about. Opening or refreshing a pinned dashboard
/// re-runs that dashboard's SQL, so the figures track the environment instead of
/// freezing at the moment it was pinned.
model PinnedDashboard {
  id            String    @id @default(uuid())
  title         String
  dashboardId   String    @map("dashboard_id")
  /// "recipe" = one of the 7 curated dashboards (data comes from dashboards.ts).
  /// "custom" = an admin-created dashboard whose query set lives in `definition`.
  kind          String    @default("recipe")
  /// For custom dashboards: { queries: [{ key, label, sql, limit? }] }. Null for recipes.
  definition    Json?
  params        Json      @default("{}")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  sourceKey     String    @default("lumentum") @map("source_key")
  cachedHtml    String?   @map("cached_html")
  cachedSummary String?   @map("cached_summary")
  refreshedAt   DateTime? @map("refreshed_at") @db.Timestamptz(6)
  lastStatus    String?   @map("last_status")
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt])
  @@map("pinned_dashboards")
}

/// Per-dashboard refresh schedule for the Recent Reports (pinned dashboards).
/// Written by the admin app (chat tool), read by the Fab Orch cron tick which
/// re-renders each pinned report of a due dashboard and caches the HTML.
/// One row per (dashboard_id, source_key). Times are UTC.
model ReportSchedule {
  id              String    @id @default(uuid())
  dashboardId     String    @map("dashboard_id")
  sourceKey       String    @default("lumentum") @map("source_key")
  frequency       String    @default("hourly")
  intervalMinutes Int?      @map("interval_minutes")
  atTime          String?   @map("at_time")
  dayOfWeek       Int?      @map("day_of_week")
  dayOfMonth      Int?      @map("day_of_month")
  enabled         Boolean   @default(true)
  nextRunAt       DateTime? @map("next_run_at") @db.Timestamptz(6)
  lastRunAt       DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastStatus      String?   @map("last_status")
  updatedById     String?   @map("updated_by_id")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  daysOfWeek      String?   @map("days_of_week")

  @@unique([dashboardId, sourceKey], map: "report_schedules_dashboard_source_key")
  @@index([enabled, nextRunAt], map: "report_schedules_enabled_next_run_idx")
  @@map("report_schedules")
}

model error_audit_daily_counter {
  counter_date DateTime @id @db.Date
  last_seq     Int      @default(0)
}

model error_audit_logs {
  id                                        String             @id
  error_id                                  String             @unique
  error_uuid                                String
  error_type                                String
  user_id                                   String?
  datetime                                  DateTime           @default(now()) @db.Timestamptz(6)
  user_message                              String
  technical_message                         String?
  priority                                  String
  status                                    error_audit_status @default(OPEN)
  resolved_by                               String?
  resolved_at                               DateTime?          @db.Timestamptz(6)
  resolution_note                           String?
  route                                     String?
  http_method                               String?
  http_status                               Int?
  stack_preview                             String?
  request_context                           Json?
  created_at                                DateTime           @default(now()) @db.Timestamptz(6)
  users_error_audit_logs_resolved_byTousers User?              @relation("error_audit_logs_resolved_byTousers", fields: [resolved_by], references: [id], map: "error_audit_logs_resolver_fkey")
  users_error_audit_logs_user_idTousers     User?              @relation("error_audit_logs_user_idTousers", fields: [user_id], references: [id], map: "error_audit_logs_user_fkey")

  @@index([datetime(sort: Desc)])
  @@index([error_id])
  @@index([priority])
  @@index([status])
  @@index([error_type], map: "error_audit_logs_type_idx")
  @@index([user_id, datetime(sort: Desc)], map: "error_audit_logs_user_datetime_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model error_catalog {
  error_type   String   @id
  user_message String
  priority     String
  http_status  Int
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_by   String   @default("system")

  @@index([updated_at(sort: Desc)], map: "idx_error_catalog_updated_at")
}

model mcp_data_sources {
  id                      String                 @id
  name                    String
  engine                  String                 @default("postgres")
  status                  mcp_data_source_status @default(DRAFT)
  host                    String?
  port                    Int?
  database                String?
  schemas_json            Json                   @default("[]")
  secret_arn              String?
  discovered_schema       Json?
  manifest                Json?
  static_check            Json?
  runtime_version         String?
  lambda_arn              String?
  endpoint_url            String?
  endpoint_auth_encrypted String?
  registry_id             String?
  last_error              String?
  created_by_id           String
  created_at              DateTime               @default(now())
  updated_at              DateTime               @default(now())

  @@index([created_by_id])
  @@index([status])
}

model mcp_registry {
  id                         String   @id
  display_name               String
  server_url                 String   @unique
  auth_type                  String   @default("none")
  created_at                 DateTime @default(now())
  description                String?
  auth_credentials_encrypted String?
  is_active                  Boolean  @default(true)
  updated_at                 DateTime @default(now())
}

model prompt_audit_daily_counter {
  counter_date DateTime @id @db.Date
  last_seq     Int      @default(0)
}

model prompt_audit_logs {
  id               String              @id
  prompt_id        String              @unique
  datetime         DateTime            @default(now()) @db.Timestamptz(6)
  user_prompt      String
  topic_matched    String?
  data_retrieved   String?
  llm_response     String?
  response_time_ms Int?
  status           prompt_audit_status @default(PENDING)
  user_name        String?
  user_email       String?
  query_executed   String?
  tool_calls       Json?
  user_id          String?
  request_tokens   Int?
  retrieval_tokens Int?
  response_tokens  Int?
  /// Per-request phase/tool timing breakdown. See add_prompt_audit_timings.sql.
  timings          Json?
  request_cost     Decimal?            @db.Decimal(12, 6)
  retrieval_cost   Decimal?            @db.Decimal(12, 6)
  response_cost    Decimal?            @db.Decimal(12, 6)
  model            String?
  users            User?               @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id], map: "idx_prompt_audit_logs_user_id")
  @@index([datetime(sort: Desc)])
  @@index([prompt_id])
  @@index([status])
  @@index([topic_matched], map: "prompt_audit_logs_topic_idx")
}

model CmfBearerToken {
  cmfDatabaseName String    @id @map("cmf_database_name")
  token           String
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("cmf_bearer_tokens")
}

model CmfConnection {
  id                   String   @id
  dbKey                String   @unique @map("db_key")
  label                String
  engine               String   @default("mssql")
  sqlServer            String   @map("sql_server")
  sqlInstance          String?  @map("sql_instance")
  sqlDatabase          String   @map("sql_database")
  sqlUser              String   @map("sql_user")
  sqlPasswordEncrypted String?  @map("sql_password_encrypted")
  passwordEnv          String?  @map("password_env")
  baseUrl              String   @map("base_url")
  hostResolver         Json     @default("[]") @map("host_resolver")
  tokenDbName          String   @map("token_db_name")
  tokenSecretId        String?  @map("token_secret_id")
  portalUser              String?  @map("portal_user")
  portalPasswordEncrypted String?  @map("portal_password_encrypted")
  lambdaArn               String?  @map("lambda_arn")
  scheduleName            String?  @map("schedule_name")
  enabled              Boolean  @default(true)
  createdById          String?  @map("created_by_id")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("cmf_connections")
}

/// Per-user / per-role grant of a CMF database connection (polymorphic: exactly
/// one of userId/roleId is set). Effective access = union of the user's direct
/// grants and their role's grants. See prisma/create_cmf_access.sql.
model CmfAccess {
  id          String   @id
  dbKey       String   @map("db_key")
  userId      String?  @map("user_id")
  roleId      String?  @map("role_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([roleId])
  @@map("cmf_access")
}

enum SessionStatus {
  ACTIVE
  CLOSED_LOGOUT
  CLOSED_IDLE
  CLOSED_ADMIN
  CLOSED_EXPIRED

  @@map("session_status")
}

enum Operation {
  VALIDATE
  LOAD

  @@map("cmf_operation")
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILURE
  EXPIRED

  @@map("cmf_run_status")
}

enum error_audit_status {
  OPEN
  RESOLVED
}

enum mcp_data_source_status {
  DRAFT
  CONNECTED
  GENERATED
  DEPLOYING
  ACTIVE
  FAILED
  RETIRED
}

enum prompt_audit_status {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
  CANCELLED
}
