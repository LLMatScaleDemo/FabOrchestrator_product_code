# Modeling Agent (CMF master-data loader) — extra environment variables.
# Add these to the fab app's .env alongside the existing keys
# (ANTHROPIC_API_KEY, DATABASE_URL, KEY_ENCRYPTION_SECRET, AWS creds, …).
#
# These are only needed by the FAB app (the Modeling Agent runs here). The
# admin app needs none of them — it reads the shared Postgres tables.

# ── CMF REST API (Master Data Load flow) ──
CMF_BASE_URL=https://atscmapp4.usa.athenatec.com
# Skip TLS verification for the self-signed / corp-CA CMF cert. Set to "0" in
# production once the corp CA root is installed.
CMF_TLS_INSECURE=1
# Optional: map the on-prem CMF host to a private IP when DNS can't resolve it.
# Format: "host=ip[,host=ip]". Leave empty on VPN/VPC where DNS works.
HOST_RESOLVER=

# ── CMF SQL Server (validation lookups via mssql) ──
CMF_SQL_SERVER=
CMF_SQL_DB=
CMF_SQL_USER=
CMF_SQL_PASS=
CMF_SQL_INSTANCE=
# Connect/request timeouts. The defaults below are proven against this CMF
# instance — it is a NAMED instance behind a VPN, so each connect pays SQL
# Browser discovery (UDP 1434) plus a dynamic-port handshake. Lowering these
# breaks connections; only raise them (e.g. on slower links).
CMF_SQL_CONNECT_TIMEOUT_MS=20000
CMF_SQL_REQUEST_TIMEOUT_MS=30000

# ── CMF Bearer token (published to AWS Secrets Manager by the cmf-auth-token
#    Lambda; rotates ~45 min). The app READS the secret at runtime and caches
#    it, refreshing only near expiry — it never writes the token. The role needs
#    secretsmanager:GetSecretValue on the cmf/mes-token-* ARN. ──
CMF_TOKEN_SECRET_ID=cmf/mes-token
CMF_TOKEN_REGION=us-west-2
TOKEN_SAFETY_MARGIN_SEC=60
AWS_REGION=us-west-2

# ── LLM overrides (optional; default to claude-opus-4-8) ──
CHAT_LLM_MODEL=claude-opus-4-8
CHAT_LLM_MAX_TOKENS=8192
CHAT_LLM_MAX_STEPS=16
VALIDATION_LLM_MODEL=claude-opus-4-8
