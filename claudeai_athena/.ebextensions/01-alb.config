option_settings:
  # ALB idle timeout: 600 seconds (10 min) for long SSE streaming
  aws:elbv2:loadbalancer:
    IdleTimeout: 600

  # ALB targets Nginx (port 80), which proxies to Docker container (port 3000)
  aws:elasticbeanstalk:environment:process:default:
    Port: 80
    Protocol: HTTP
    StickinessEnabled: true
    StickinessLBCookieDuration: 600
    # Health check hits the dedicated /api/health probe (no DB / no render), NOT
    # the heavy "/" login page. This keeps a busy-but-alive instance in service
    # during a heavy export or slow VPN query instead of yanking it and 504-ing
    # every user (prod incidents 2026-08-10, 2026-08-19). Thresholds are a touch
    # more tolerant so a brief spike can't trip a false unhealthy.
    HealthCheckPath: /api/health
    HealthCheckTimeout: 10
    HealthCheckInterval: 15
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
    MatcherHTTPCode: 200
